# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Job queue (Redis / BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Transcription ---
ASSEMBLYAI_API_KEY=

# --- LLM segment selection ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Visual generation (feature-flagged, see CLAUDE.md) ---
# Higgsfield's redistribution licensing is confirmed (commercial use is
# allowed), so both vars are meant to be "true" in production. Both must be
# set to turn the path on — NEXT_PUBLIC_* controls whether the UI offers it,
# GENERATE_VISUALS_ENABLED controls whether the API will actually accept it,
# so a stale client build can never bypass the gate.
GENERATE_VISUALS_ENABLED=true
NEXT_PUBLIC_GENERATE_VISUALS_ENABLED=true
# Higgsfield auth is a two-part credential ("Authorization: Key
# KEY_ID:KEY_SECRET"), both values from the Higgsfield dashboard's API
# credentials page — not a single API key.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_API_URL=https://platform.higgsfield.ai

# --- Text-to-speech / AI voiceover (feature-flagged, see CLAUDE.md) ---
# Same dual-flag pattern as generate-visuals above.
TTS_ENABLED=false
NEXT_PUBLIC_TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io

# --- Outbound email (transactional: cancellation confirmations, contact form) ---
# See src/lib/email.ts — logs instead of sending until this is set.
RESEND_API_KEY=

# --- Contact / agency lead notifications ---
CONTACT_NOTIFY_EMAIL=
