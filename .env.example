# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Job queue (Redis / BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Transcription ---
ASSEMBLYAI_API_KEY=

# --- LLM segment selection ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Visual generation (feature-flagged, see CLAUDE.md) ---
# Keep OFF by default in any environment pointed at real users until
# Higgsfield's redistribution licensing is confirmed. Both vars must be set
# to "true"/the server flag on to turn the path on — NEXT_PUBLIC_* controls
# whether the UI offers it, GENERATE_VISUALS_ENABLED controls whether the API
# will actually accept it, so a stale client build can never bypass the gate.
GENERATE_VISUALS_ENABLED=false
NEXT_PUBLIC_GENERATE_VISUALS_ENABLED=false
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=https://platform.higgsfield.ai

# --- Outbound email (transactional: cancellation confirmations, contact form) ---
# See src/lib/email.ts — logs instead of sending until this is set.
RESEND_API_KEY=

# --- Contact / agency lead notifications ---
CONTACT_NOTIFY_EMAIL=
