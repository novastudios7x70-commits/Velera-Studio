# --- Supabase (service role — this process bypasses RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Job queue (must point at the same Redis instance as the Next.js app) ---
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# --- Transcription ---
ASSEMBLYAI_API_KEY=

# --- LLM segment selection ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Visual generation (feature-flagged — keep false until Higgsfield
# redistribution licensing is confirmed, see CLAUDE.md) ---
GENERATE_VISUALS_ENABLED=false
# Higgsfield auth is a two-part credential ("Authorization: Key
# KEY_ID:KEY_SECRET"), both values from the Higgsfield dashboard's API
# credentials page — not a single API key.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_API_URL=https://platform.higgsfield.ai
# Overrides the guessed text-to-video model name if it turns out wrong —
# see the comment in src/pipeline/generateVisuals.ts.
HIGGSFIELD_T2V_MODEL=seedance-v2.0-t2v

# --- Optional ---
PYTHON_BIN=python3
